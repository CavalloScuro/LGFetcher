{
  "manifest_version": 2,
  "name": "LGFetcher",
  "version": "1.1.0",
  "description": "Fetch books and articles from LibGen directly into Zotero.",
  "author": "LGFetcher",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "lgfetcher@example.com",
      "update_url": "https://example.com/lgfetcher/updates.json",
      "strict_min_version": "9.0",
      "strict_max_version": "9.0.*"
    }
  }
}
